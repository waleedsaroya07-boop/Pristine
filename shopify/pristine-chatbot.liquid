<div data-pristine-chatbot-host hidden>
  <div class="pa-chat-lead" hidden>
    <h3>Send your wholesale enquiry</h3>
    <p>Your specification will be included automatically. Submitting this form does not place an order or take payment.</p>
    {% form 'contact', id: 'PristineChatLead', class: 'pa-chat-lead-form' %}
      {% if form.posted_successfully? %}<p>Thanks. Your wholesale enquiry has been sent for review.</p>{% endif %}
      {{ form.errors | default_errors }}
      <label for="PristineLeadName">Name</label>
      <input id="PristineLeadName" name="contact[name]" autocomplete="name" required>
      <label for="PristineLeadOrganisation">Organisation</label>
      <input id="PristineLeadOrganisation" name="contact[Organisation]" autocomplete="organization">
      <label for="PristineLeadEmail">Email</label>
      <input id="PristineLeadEmail" name="contact[email]" type="email" autocomplete="email" required>
      <label for="PristineLeadPhone">Phone / WhatsApp</label>
      <input id="PristineLeadPhone" name="contact[phone]" type="tel" autocomplete="tel">
      <label for="PristineLeadDestination">Delivery destination</label>
      <input id="PristineLeadDestination" name="contact[Delivery destination]">
      <textarea name="contact[body]" hidden></textarea>
      <button type="submit">Submit enquiry</button>
    {% endform %}
  </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/waleedsaroya07-boop/Pristine@bd5baf1d3cd82a7ae5f66e26382d9d8544ea6ef5/static/chatbot.css">
<script src="https://cdn.jsdelivr.net/gh/waleedsaroya07-boop/Pristine@bd5baf1d3cd82a7ae5f66e26382d9d8544ea6ef5/static/chatbot.js" defer></script>

{% schema %}
{"name":"Pristine Chatbot","settings":[],"presets":[{"name":"Pristine Chatbot"}]}
{% endschema %}
